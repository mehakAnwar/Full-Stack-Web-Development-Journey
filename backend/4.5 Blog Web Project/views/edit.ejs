
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Post | MyBlog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <nav class="navbar navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">MyBlog</a>
            <a href="/" class="btn btn-outline-light">Back to Home</a>
        </div>
    </nav>
    <section class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-7">
                <div class="card shadow border-0">
                    <div class="card-body p-4 p-md-5">
                        <h1 class="text-center fw-bold mb-4">Edit Post</h1>
                        <form action="/edit/<%= post.id %>" method="POST">
                            <div class="mb-3">
                                <label for="title" class="form-label fw-semibold">Post Title</label>
                                <input type="text" class="form-control form-control-lg" id="title" name="title" value="<%= post.title %>" required>
                            </div>
                            <div class="mb-4">
                                <label for="content" class="form-label fw-semibold">Post Content</label>
                                <textarea class="form-control" id="content" name="content" rows="7" required><%= post.content %></textarea>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-dark btn-lg"> Update Post </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</body>
</html>
